# PhishGuard configuration template.
# Copy to .env and fill in real values. NEVER commit .env.

# --- Mailbox (your OWN test account only) ---
IMAP_HOST=imap.gmail.com
IMAP_USER=your-test-account@gmail.com
# 16-character Google app password (NOT your real Gmail password)
IMAP_APP_PASSWORD=change-me
IMAP_QUARANTINE_FOLDER=PhishGuard-Quarantine
IMAP_POLL_SECONDS=60

# --- Behaviour ---
# monitor = report only; quarantine = move phishing to the quarantine folder (never deletes)
MODE=monitor
QUARANTINE_THRESHOLD=0.8
MAX_EMAIL_BYTES=5242880
# Only Authentication-Results added by YOUR mail provider are trusted for "pass" results.
# Gmail: mx.google.com   Outlook.com: (check a received message's top header)
TRUSTED_AUTHSERV_ID=mx.google.com

# --- Web / API access ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me
FLASK_SECRET_KEY=change-me
# Generate with: python -c "from werkzeug.security import generate_password_hash as g; print(g('your-password'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=change-me

# --- Optional / future ---
INTEL_ENABLED=false
